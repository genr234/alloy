#!/usr/bin/env bash

# omarchy:summary=Remove packages (alloy: explains how, since software comes from the flake)
#
# Also installed as omarchy-pkg-remove.

present=()
for pkg in "$@"; do
  [[ $pkg == -* ]] && continue
  omarchy-pkg-present "$pkg" && present+=("$pkg")
done
((${#present[@]} == 0)) && exit 0

echo "alloy: ${present[*]} comes from the flake. Remove it from the alloy flake (or set alloy.omarchy.skipPackages) and rebuild." >&2
if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v notify-send >/dev/null; then
  notify-send -a Omarchy "Still installed: ${present[*]}" "Remove it in your alloy flake and rebuild." || true
fi
exit 1
